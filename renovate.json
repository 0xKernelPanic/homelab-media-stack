{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "linuxserver.io tags look like 4.0.20.3014-ls327: compare the version, ignore the build suffix",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/**"],
      "versioning": "regex:^(?<compatibility>.*?)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:_v[\\d.]+)?(?:ubu\\d+)?-ls(?<revision>\\d+)$"
    },
    {
      "description": "patch updates of the media apps are routine: group them in one pull request a week",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "patch updates",
      "schedule": ["before 6am on monday"]
    }
  ]
}
