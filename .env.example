# Copy to .env and fill in. .env is ignored by git: it holds your VPN keys.

# --- Host -------------------------------------------------------------------
# User and group that own the data (run `id` on the host).
PUID=1000
PGID=1000
TZ=Europe/Warsaw
# One root for downloads and the library, so imports are instant hardlinks
# instead of copies. The library Jellyfin serves lives in $DATA_DIR/jellyfin.
DATA_DIR=/data

# --- VPN (gluetun) ----------------------------------------------------------
# Provider-specific settings: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=Netherlands
# Subnets allowed past gluetun's kill switch: your LAN (so the web UIs answer)
# and the stack's own network (so Prowlarr can reach Sonarr, Radarr and Lidarr).
FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24,172.39.0.0/24
# Port forwarded by the VPN provider, for incoming peers (optional).
#FIREWALL_VPN_INPUT_PORTS=

# --- Web apps ---------------------------------------------------------------
# The URL Profilarr is opened at (behind your reverse proxy).
PROFILARR_ORIGIN=https://profilarr.example.lan
# Every hostname the Halcyon store is opened at, comma separated.
HALCYON_ALLOWED_HOSTS=media,halcyon.example.lan
